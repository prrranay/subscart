# Root GitIgnore for Subscart (Full-Stack Monorepo)

# Dependencies & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# NestJS / TypeScript Builds
dist/
coverage/
*.tsbuildinfo

# Flutter & Dart Builds
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# Android Specific
frontend/android/.gradle/
frontend/android/captures/
frontend/android/gradlew
frontend/android/gradlew.bat
frontend/android/local.properties
frontend/android/GeneratedPluginRegistrant.java
frontend/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
*.apk
*.aab

# iOS / macOS Specific
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
**/.DS_Store
.Spotlight-V100
.Trashes

# Windows Specific
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE & Editor Settings
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
